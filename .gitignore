# Virtual environments
venv/
backend/venv/
.venv/

# Node dependencies & build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
backend/__pycache__/

# Camera snapshots & edge cache
backend/uploads/*
!backend/uploads/.gitkeep
edge/cache/
*.jpg
*.jpeg
*.png

# Local SQLite databases (prevent committing active tracking DB)
*.db
*.sqlite
*.sqlite3

# Large AI model weights (optional / recommended to avoid bloating Git)
*.pt

# OS & browser test profiles
.DS_Store
Thumbs.db
chrome-profile/
